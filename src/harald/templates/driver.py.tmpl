"""a standalone driver for one bluetooth le gadget, written by harald.

it has its own command line and does not need harald. run it with uv, which installs
bleak and cryptography from the block above:

    uv run driver.py --help
    uv run driver.py <command> [values]

each command builds a plaintext payload, encrypts it when CIPHER is set, and writes
it to WRITE_CHAR_UUID: without response when the characteristic allows that, with
response otherwise. with no --address and no ADDRESS_HINT, it scans for a device
advertising SERVICE_UUID or, when NAME_HINT is set, one whose name starts with it.
"""

from __future__ import annotations

import argparse
import asyncio
import contextlib
import sys

from bleak import BleakClient, BleakScanner
from bleak.exc import (
    BleakBluetoothNotAvailableError,
    BleakDeviceNotFoundError,
    BleakError,
)
from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes

DEVICE = $device
VENDOR = $vendor
ADDRESS_HINT = $address_hint  # empty: scan for SERVICE_UUID or NAME_HINT
# set for gadgets that do not advertise SERVICE_UUID: the scan then also takes a
# device whose name starts with this
NAME_HINT = $name_hint
SERVICE_UUID = $service_uuid
WRITE_CHAR_UUID = $write_char_uuid
CIPHER = $cipher  # None, "aes-ecb" or "aes-cbc-zero-iv"
KEY_HEX = $key_hex
SCAN_SECONDS = 5.0
NOT_FOUND_HINT = (
    "switch the gadget on, close the vendor app on your phone (gadgets accept one "
    "connection), move closer, or pass --address"
)

$payload_code


def wanted_device() -> str:
    """What the scan looks for, in words."""
    if NAME_HINT:
        return f"device advertising {SERVICE_UUID} or named {NAME_HINT}*"
    return f"device advertising {SERVICE_UUID}"


def is_wanted(device, adv) -> bool:
    """True if the advert has SERVICE_UUID, or a name starting with NAME_HINT."""
    if SERVICE_UUID in (uuid.lower() for uuid in adv.service_uuids):
        return True
    name = adv.local_name or device.name or ""
    return bool(NAME_HINT) and name.startswith(NAME_HINT)


async def find_device():
    """Scan for SCAN_SECONDS and return the strongest device that `is_wanted`."""
    print(f"scanning {SCAN_SECONDS:g} s for a {wanted_device()}")
    # on macos a service filter hides every device that does not advertise it, so
    # filter only when there is no name to look for
    service_filter = {} if NAME_HINT else {"service_uuids": [SERVICE_UUID]}
    found = await BleakScanner.discover(
        timeout=SCAN_SECONDS, return_adv=True, **service_filter
    )
    matches = [
        (adv.rssi, device) for device, adv in found.values() if is_wanted(device, adv)
    ]
    if not matches:
        raise DriverError(f"no {wanted_device()} found", NOT_FOUND_HINT)
    device = max(matches, key=lambda match: match[0])[1]
    if len(matches) > 1:
        print(f"found {len(matches)} devices; using the strongest, {device.address}")
    return device


async def send(address: str, payload: bytes) -> str:
    """Write `payload` to WRITE_CHAR_UUID on the gadget. Returns the address used."""
    target = address
    if not address:
        target = await find_device()
        address = target.address
    client = BleakClient(target)
    try:
        await client.connect()
    except (BleakDeviceNotFoundError, TimeoutError) as exc:
        raise DriverError(f"device {address} not found", NOT_FOUND_HINT) from exc
    try:
        # look in SERVICE_UUID first, then anywhere else on the gadget
        services = sorted(client.services, key=lambda s: s.uuid.lower() != SERVICE_UUID)
        chars = [
            char
            for service in services
            for char in service.characteristics
            if char.uuid.lower() == WRITE_CHAR_UUID
        ]
        if not chars:
            raise DriverError(
                f"characteristic {WRITE_CHAR_UUID} not found on {address}",
                "check that the address belongs to this gadget, or pass --address",
            )
        response = "write-without-response" not in chars[0].properties
        await client.write_gatt_char(chars[0], payload, response=response)
    finally:
        # a failing disconnect must not replace the result or the original error
        with contextlib.suppress(BleakError, OSError, TimeoutError):
            await client.disconnect()
    return address


$cli_code


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    _function, params = COMMANDS[args.command]
    values = [getattr(args, param) for param in params]
    try:
        payload = encrypt(build_payload(args.command, values))
        address = asyncio.run(send(args.address, payload))
    except DriverError as exc:
        return fail(exc.message, exc.hint)
    except BleakBluetoothNotAvailableError:
        return fail(
            "bluetooth is off or not allowed for this app",
            "turn bluetooth on and allow your terminal app in "
            "system settings > privacy & security > bluetooth",
        )
    except (BleakError, TimeoutError) as exc:
        return fail(
            f"bluetooth error: {str(exc).lower() or type(exc).__name__.lower()}",
            "check that the gadget is on and in range, then try again",
        )
    except KeyboardInterrupt:
        return 130
    print(f"sent {args.command} to {address}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
